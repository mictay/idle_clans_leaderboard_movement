{
    "crons": [
        {
            "path": "/api/update-leaderboard?startIndex=0&stopIndex=42",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/update-leaderboard?startIndex=43&stopIndex=69",
            "schedule": "5 0 * * *"
        },
        {
            "path": "/api/update-leaderboard?startIndex=70",
            "schedule": "10 0 * * *"
        },
        {
            "path": "/api/calculate-top-movers",
            "schedule": "15 0 * * *"
        }
    ],
    "headers": [
        {
            "source": "/api/get-all-movements",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "https://${VERCEL_URL}"
                },
                {
                    "key": "Vary",
                    "value": "Origin"
                }
            ]
        }
    ]
}